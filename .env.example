# Copy to .env (never commit .env). All values are optional.

# Translation check (meaning, missing/added content, names and numbers). It runs automatically when a key is set:
# Gemini is used when GEMINI_API_KEY is set, otherwise Claude when ANTHROPIC_API_KEY is set.
# Without either, the report shows the translation check as "not measured"; everything else still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# low ≈ 3 s per review, high ≈ 40 s
GEMINI_THINKING=low

ANTHROPIC_API_KEY=
CLAUDE_JUDGE_MODEL=claude-opus-5-5

# Speech recognition model. base (145 MB) is fast and gave the same results as small (484 MB) on the sample.
WHISPER_MODEL=base

# Number of app run folders (reports) kept in data/output/runs/.
MAX_KEPT_RUNS=10
# Share links whose downloads and speech recognition stay cached (data/cache/)
MAX_CACHED_LINKS=20
