# Copy to .env (never commit .env). All values are optional.

# Perso API key (https://developers.perso.ai/api-keys). If unset, the key registered with the
# Perso CLI (node .agents/skills/dubbing/scripts/connect.mjs → ~/.perso/credentials) is used.
PERSO_API_KEY=

# Default workspace when your account has several (the app also lets you pick one in the sidebar).
PERSO_SPACE_SEQ=

# Default speech recognition model: tiny | base | small | medium | large
WHISPER_MODEL=small

# Number of dubbed-run folders kept in data/output/runs/.
MAX_KEPT_RUNS=10
